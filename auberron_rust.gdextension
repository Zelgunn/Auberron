[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://auberron_rust/target/debug/libauberron_rust.so"
linux.release.x86_64 =   "res://auberron_rust/target/release/libauberron_rust.so"
windows.debug.x86_64 =   "res://auberron_rust/target/debug/auberron_rust.dll"
windows.release.x86_64 = "res://auberron_rust/target/release/auberron_rust.dll"
macos.debug =            "res://auberron_rust/target/debug/libauberron_rust.dylib"
macos.release =          "res://auberron_rust/target/release/libauberron_rust.dylib"
macos.debug.arm64 =      "res://auberron_rust/target/debug/libauberron_rust.dylib"
macos.release.arm64 =    "res://auberron_rust/target/release/libauberron_rust.dylib"
